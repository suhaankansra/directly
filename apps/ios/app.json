{
  "expo": {
    "name": "Directly",
    "slug": "directly",
    "version": "0.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "directly",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.directly.app",
      "buildNumber": "3",
      "requireFullScreen": false,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "com.directly.app",
      "versionCode": 3,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "dms",
          "color": "#6c5ce7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
