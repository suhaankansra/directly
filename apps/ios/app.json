{
  "expo": {
    "name": "Directly",
    "slug": "directly",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "directly",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.directly.app",
      "requireFullScreen": false,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "com.directly.app",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [],
    "experiments": {
      "typedRoutes": false
    }
  }
}
