{
  "version": 1,
  "layout": "mobile",
  "comment": "Candidate selectors, most stable first. Never obfuscated class names. Overridable at runtime as pure data (D018).",
  "selectors": {
    "bottomNav": ["nav[role='navigation']", "div[role='navigation']"],
    "navHome": ["a[href='/']", "a[href='https://www.instagram.com/']"],
    "navExplore": ["a[href='/explore/']", "a[href='/explore/search/']"],
    "navReels": ["a[href='/reels/']"],
    "navCreate": ["a[href='/create/select/']", "svg[aria-label='New post']"],
    "navSearch": ["a[href='/explore/search/']", "a[aria-label='Search']"],
    "storiesRail": ["div[role='list']", "ul[role='list']"],
    "reelScroller": [
      "div[style*='scroll-snap-type']",
      "div[style*='scroll-snap']",
      "main div[role='presentation']"
    ],
    "reelSlide": ["article", "div[role='group']"],
    "reelNext": ["button[aria-label='Next']", "svg[aria-label='Next']"],
    "reelPrev": ["button[aria-label='Previous']", "svg[aria-label='Previous']"],
    "appBanner": ["div[role='banner']", "div[role='dialog']"],
    "accountChevron": ["svg[aria-label='Down chevron icon']", "header a[href='#']"]
  }
}
