{
  "name": "only-inbox",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter @only-inbox/core build && pnpm -r --filter @only-inbox/extension build && pnpm -r --filter @only-inbox/web build",
    "build:core": "pnpm --filter @only-inbox/core build",
    "build:extension": "pnpm --filter @only-inbox/extension build",
    "build:web": "pnpm --filter @only-inbox/web build",
    "test": "pnpm --filter @only-inbox/core test",
    "test:watch": "pnpm --filter @only-inbox/core test:watch",
    "typecheck": "pnpm -r typecheck",
    "fixture": "node packages/core/test/fixtures/serve.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^24.19.2",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
